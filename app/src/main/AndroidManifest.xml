<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 掃藥袋：凱比只有一顆前鏡頭，不要求一定有後鏡頭 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- 連後端 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 準時提醒：精準鬧鐘（不上架 Play，USE_EXACT_ALARM 系統會自動允許，D35）、開機後重排、通知 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Nuwa SDK 自帶這兩個系統權限，一般 App 用不到也拿不到，合併時移除，免得打包時被檢查擋下 -->
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" tools:node="remove" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" tools:node="remove" tools:ignore="ProtectedPermissions" />

    <queries>
        <!-- 模擬器測試用的 Android 語音 -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- 凱比原廠服務（換機器也要綁得上） -->
        <package android:name="com.nuwarobotics.service" />
        <package android:name="com.nuwarobotics.app.facepresenter" />
        <package android:name="com.nuwarobotics.service.systempet" />
    </queries>

    <application
        android:name=".KebbiApp"
        android:allowBackup="false"
        android:label="用藥提醒"
        android:icon="@drawable/ic_medreminder"
        android:supportsRtl="false"
        android:theme="@style/Theme.Kebbi"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|density"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 大螢幕的 Android 15 會對固定方向的 App 套用相機相容處理；App 自己處理橫向相機，所以退出（QR 移植文件 4.3） -->
            <property android:name="android.window.PROPERTY_CAMERA_COMPAT_ALLOW_FORCE_ROTATION" android:value="false" />
            <property android:name="android.window.PROPERTY_CAMERA_COMPAT_ALLOW_REFRESH" android:value="false" />
        </activity>

        <receiver android:name=".engine.AlarmReceiver" android:exported="false" />
        <receiver android:name=".engine.NotificationActionReceiver" android:exported="false" />
        <!-- CR-27：不 exported。系統廣播（開機、更新、改時間）照樣收得到 -->
        <receiver android:name=".engine.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
